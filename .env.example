# Modelo das variáveis de ambiente do Partiu IF.
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA coloque valores reais aqui: este arquivo vai para o GitHub.

# --- Supabase (preenchidas na Etapa 2, quando o projeto for criado) ---
# URL do projeto Supabase (pública, pode ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable/anon). Segura no navegador porque a RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave de serviço: SECRETA, só no servidor. Nunca use o prefixo NEXT_PUBLIC_ nela
SUPABASE_SERVICE_ROLE_KEY=
